# Copy to .env and set your OpenAI key
OPENAI_API_KEY=
# Where the FAISS index and metadata will be stored by default
INDEX_PATH=outputs/index.faiss
META_PATH=outputs/meta.npy
# Local sentence-transformers model name (optional)
LOCAL_SENTENCE_MODEL=all-MiniLM-L6-v2
# ASR_MODE: openai | local | azure
ASR_MODE=local
# Azure / models.github.ai inference settings (if you want to use that endpoint)
# Provide either GITHUB_TOKEN or AZURE_KEY with inference permissions
GITHUB_TOKEN=
AZURE_INFERENCE_ENDPOINT=https://models.github.ai/inference
AZURE_MODEL_NAME=microsoft/Phi-4-multimodal-instruct
